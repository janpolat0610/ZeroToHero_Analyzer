[Unit]
Description=Zero to Hero English — AI Channel Analyzer Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ZeroToHero_Analyzer
ExecStart=/root/ZeroToHero_Analyzer/.venv/bin/python main.py
Restart=always
RestartSec=5
EnvironmentFile=/root/ZeroToHero_Analyzer/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8

[Install]
WantedBy=multi-user.target
